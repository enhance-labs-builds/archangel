{
  "name": "archangel-site",
  "private": true,
  "type": "module",
  "description": "The archangel documentation site. Its examples run on the published @enhance-eng/archangel.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/diagnostics.mjs && astro dev",
